# Neon Postgres (pooled connection string)
DATABASE_URL=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app (callback: <site>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev or https://media.example.com (no trailing slash)
R2_PUBLIC_URL=

# Optional: absolute site URL for OpenGraph image URLs, e.g. https://folio.example.com
NEXT_PUBLIC_SITE_URL=
